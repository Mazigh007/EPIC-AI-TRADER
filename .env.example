# EPIC AI Trader Studio backend settings
# Copy to .env for local use, but never commit real credentials.

PORT=8080

# Keep false until you have implemented, tested, and approved the broker workflow.
LIVE_TRADING_ENABLED=false

# Select one live adapter when using generic BROKER_API_KEY / BROKER_API_SECRET fallback.
# Supported values: alpaca, binance, coinbase
LIVE_BROKER_ADAPTER=alpaca

# Global safety switch. Keep true for sandbox/testnet/dry-run behavior.
BROKER_SANDBOX=true

# Active AI agent settings
# free-rules works immediately. ollama uses a free local LLM if Ollama is running on your machine.
AI_AGENT_PROVIDER=free-rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=20000
ACTIVE_AGENT_ALLOW_PAPER_EXECUTION=true
ACTIVE_AGENT_ALLOW_LIVE_EXECUTION=false

# Generic fallback credentials used only when LIVE_BROKER_ADAPTER matches the selected broker.
BROKER_API_KEY=
BROKER_API_SECRET=

# Alpaca Trading API
# Sandbox uses https://paper-api.alpaca.markets by default.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true
ALPACA_BASE_URL=

# Binance Spot API
# Sandbox uses https://testnet.binance.vision by default.
# By default sandbox submits to /api/v3/order/test. Set BINANCE_CREATE_SANDBOX_ORDER=true to create testnet orders.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_CREATE_SANDBOX_ORDER=false
BINANCE_BASE_URL=

# Coinbase Advanced Trade API
# Sandbox mode is a backend dry run by default; no real Coinbase order is sent.
# For real Coinbase live orders you must set BROKER_SANDBOX=false and COINBASE_ALLOW_LIVE=true.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_SANDBOX=true
COINBASE_ALLOW_LIVE=false
COINBASE_API_HOST=api.coinbase.com
COINBASE_BASE_URL=
