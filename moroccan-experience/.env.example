# ---------------------------------------------------------------------------
# Moroccan Experience — environment
# Copy to .env and fill in. Nothing here is required to run the site locally:
# without STRIPE_SECRET_KEY the storefront runs a clearly-labelled DEMO
# checkout that collects no card data at all.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Where the site is publicly served. Used for OG tags, sitemap.xml and the
# Stripe success/cancel redirects. Leave blank to derive from the request.
PUBLIC_URL=

# --- Stripe -----------------------------------------------------------------
# Test mode: use a sk_test_ key and https://dashboard.stripe.com/test/apikeys
# Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: a pre-created Stripe Price for the 75% balance invoice.
STRIPE_PRICE_BALANCE_DUE=

# --- Contact details shown across the site ----------------------------------
SITE_PHONE=+212 524 29 00 00
SITE_WHATSAPP=+212 661 23 45 67
SITE_EMAIL=journeys@moroccan-experience.com

# --- Commercial terms ---------------------------------------------------------
DEPOSIT_PERCENT=25
BALANCE_DUE_DAYS=60
LUXURY_DAY_RATE=857.143
PRIVATE_DAY_RATE=460
SINGLE_SUPPLEMENT=175

# --- Optional: give the assistant a real LLM ----------------------------------
# Without a key the assistant answers deterministically from the site's own
# itineraries, prices and policies (which is usually the safer behaviour).
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Operator only ------------------------------------------------------------
# Protects GET /api/admin/bookings with an x-admin-token header.
ADMIN_TOKEN=
