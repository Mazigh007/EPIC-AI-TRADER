{
  "name": "moroccan-experience-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "Moroccan Experience — luxury, private, bespoke and group tour storefront with Stripe deposit checkout, booking conditions, privacy policy, legal terms, sitemap and an on-site AI travel assistant.",
  "main": "server/index.js",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/",
    "test:pricing": "node --test tests/pricing.test.js",
    "test:api": "node --test tests/api.test.js",
    "checkout": "node scripts/simulate-checkout.js",
    "audit:content": "node scripts/audit.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "stripe": "^17.7.0"
  }
}
